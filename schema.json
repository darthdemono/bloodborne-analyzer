{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Bloodborne save summary",
 "oneOf": [
  {
   "type": "object",
   "required": [
    "file",
    "size",
    "empty",
    "header",
    "character",
    "inventory",
    "gems",
    "equipped",
    "storage",
    "keyItems",
    "lanterns",
    "bosses",
    "integrity"
   ],
   "properties": {
    "file": {
     "type": "string"
    },
    "size": {
     "type": "integer"
    },
    "empty": {
     "type": "boolean"
    },
    "header": {
     "type": "object",
     "required": [
      "loadedMap",
      "playtimeMs",
      "playtime"
     ],
     "properties": {
      "loadedMap": {
       "type": "string"
      },
      "playtimeMs": {
       "type": "integer"
      },
      "playtime": {
       "type": "string"
      }
     }
    },
    "character": {
     "type": "object",
     "required": [
      "name",
      "level",
      "levelFromStats",
      "stats",
      "health",
      "stamina",
      "bloodEchoes",
      "insight",
      "gender",
      "voice",
      "origin",
      "newGameCycle",
      "deaths"
     ],
     "properties": {
      "name": {
       "type": "string"
      },
      "level": {
       "type": "integer"
      },
      "levelFromStats": {
       "type": "integer"
      },
      "stats": {
       "type": "object",
       "required": [
        "vigor",
        "endurance",
        "strength",
        "skill",
        "bloodtinge",
        "arcane"
       ],
       "properties": {
        "vigor": {
         "type": "integer"
        },
        "endurance": {
         "type": "integer"
        },
        "strength": {
         "type": "integer"
        },
        "skill": {
         "type": "integer"
        },
        "bloodtinge": {
         "type": "integer"
        },
        "arcane": {
         "type": "integer"
        }
       }
      },
      "health": {
       "type": "object",
       "required": [
        "current",
        "withBuffs",
        "base"
       ],
       "properties": {
        "current": {
         "type": "integer"
        },
        "withBuffs": {
         "type": "integer"
        },
        "base": {
         "type": "integer"
        }
       }
      },
      "stamina": {
       "type": "object",
       "required": [
        "current",
        "withBuffs",
        "base"
       ],
       "properties": {
        "current": {
         "type": "integer"
        },
        "withBuffs": {
         "type": "integer"
        },
        "base": {
         "type": "integer"
        }
       }
      },
      "bloodEchoes": {
       "type": "integer"
      },
      "insight": {
       "type": "integer"
      },
      "gender": {
       "type": "integer"
      },
      "voice": {
       "type": "integer"
      },
      "origin": {
       "type": "integer"
      },
      "newGameCycle": {
       "type": "integer"
      },
      "deaths": {
       "type": "integer"
      }
     }
    },
    "inventory": {
     "type": "object",
     "required": [
      "goods",
      "armor",
      "weapons",
      "gems",
      "other"
     ],
     "properties": {
      "goods": {
       "type": "string"
      },
      "armor": {
       "type": "string"
      },
      "weapons": {
       "type": "string"
      },
      "gems": {
       "type": "string"
      },
      "other": {
       "type": "string"
      }
     }
    },
    "gems": {
     "type": "string"
    },
    "equipped": {
     "type": "object",
     "required": [
      "weapons",
      "armor"
     ],
     "properties": {
      "weapons": {
       "type": "string"
      },
      "armor": {
       "type": "string"
      }
     }
    },
    "storage": {
     "type": "object",
     "required": [
      "goods",
      "armor",
      "weapons",
      "gems",
      "other"
     ],
     "properties": {
      "goods": {
       "type": "string"
      },
      "armor": {
       "type": "string"
      },
      "weapons": {
       "type": "string"
      },
      "gems": {
       "type": "string"
      },
      "other": {
       "type": "string"
      }
     }
    },
    "keyItems": {
     "type": "object",
     "required": [
      "goods",
      "armor",
      "weapons",
      "gems",
      "other"
     ],
     "properties": {
      "goods": {
       "type": "string"
      },
      "armor": {
       "type": "string"
      },
      "weapons": {
       "type": "string"
      },
      "gems": {
       "type": "string"
      },
      "other": {
       "type": "string"
      }
     }
    },
    "lanterns": {
     "type": "object",
     "required": [
      "known",
      "lit"
     ],
     "properties": {
      "known": {
       "type": "integer"
      },
      "lit": {
       "type": "string"
      }
     }
    },
    "bosses": {
     "type": "object",
     "required": [
      "tracked",
      "defeated"
     ],
     "properties": {
      "tracked": {
       "type": "integer"
      },
      "defeated": {
       "type": "string"
      }
     }
    },
    "integrity": {
     "type": "object",
     "required": [
      "fileBytes",
      "username",
      "inventory",
      "storage",
      "keyItems",
      "flags",
      "decodedBytes",
      "note"
     ],
     "properties": {
      "fileBytes": {
       "type": "integer"
      },
      "username": {
       "type": "integer"
      },
      "inventory": {
       "type": "integer"
      },
      "storage": {
       "type": "integer"
      },
      "keyItems": {
       "type": "integer"
      },
      "flags": {
       "type": "integer"
      },
      "decodedBytes": {
       "type": "integer"
      },
      "note": {
       "type": "string"
      }
     }
    }
   }
  },
  {
   "type": "object",
   "required": [
    "file",
    "size",
    "empty",
    "integrity"
   ]
  }
 ]
}
